# From dashboard.plaid.com → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# "production" for real banks (the free Trial plan uses production), "sandbox" for fake test data
PLAID_ENV=production

# Two different long random strings (40+ characters). On a Mac: openssl rand -hex 32
# BRIDGE_SECRET is the key Claude and the setup page use to reach this server.
BRIDGE_SECRET=
# ENCRYPTION_KEY encrypts bank access tokens in the database. Don't change it after linking banks.
ENCRYPTION_KEY=

# Filled in automatically when you add Upstash Redis in Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
